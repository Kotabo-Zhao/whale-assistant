<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:background="@color/harness_page_background">

        <Button
            android:id="@+id/harness_manage"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_harness_tool"
            android:textColor="@color/harness_search_focus"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/harness_return_home" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/harness_page_title"
            android:textColor="@color/harness_toolbar_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Space android:layout_width="80dp" android:layout_height="1dp" />
    </LinearLayout>

    <WebView
        android:id="@+id/harness_web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/harness_page_background" />

    <LinearLayout
        android:id="@+id/harness_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <Button
            style="@style/WhaleToolButton"
            android:id="@+id/harness_voice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/harness_voice" />

        <Button
            style="@style/WhaleToolButton"
            android:id="@+id/harness_speak"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/harness_speak" />

        <Button
            style="@style/WhaleToolButton"
            android:id="@+id/harness_companion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/harness_companion" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@color/harness_toolbar_background">
        <LinearLayout
            android:id="@+id/harness_tab_home"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/harness_tab_home">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_whale_nav_home" android:tint="@color/harness_search_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:importantForAccessibility="no"
                android:text="@string/harness_tab_home" android:textColor="@color/harness_search_muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/harness_tab_active"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/harness_tab_chat_active"
            android:background="@drawable/bg_harness_active_tab">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_whale_nav_chat" android:tint="@color/harness_search_focus" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:importantForAccessibility="no"
                android:text="@string/harness_tab_chat" android:textColor="@color/harness_search_focus" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/harness_tab_plugins"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/harness_tab_plugins">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_whale_nav_plugins" android:tint="@color/harness_search_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:importantForAccessibility="no"
                android:text="@string/harness_tab_plugins" android:textColor="@color/harness_search_muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/harness_tab_settings"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/harness_tab_settings">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_whale_nav_settings" android:tint="@color/harness_search_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:importantForAccessibility="no"
                android:text="@string/harness_tab_settings" android:textColor="@color/harness_search_muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
